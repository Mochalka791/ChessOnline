@page "/menu"
@page "/menu/"
@layout BlankLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Arcade • Home</PageTitle>

<canvas id="bg"></canvas>

<header class="topbar">
    <div class="brand">ARCUDIS</div>
    <nav class="actions">
        <a class="btn ghost" href="/login/">Anmelden</a>
    </nav>
</header>

<main class="home">
    <section class="hero">
        <h1>Arcade</h1>
        <p>Wähle dein Spiel</p>
    </section>

    <section class="grid">
        @foreach (var game in Games)
        {
            <a class="@GetCardClasses(game)" href="@game.Href">
                <div class="thumb @game.ThumbClass"></div>
                <div class="card-body">
                    <h2>
                        @game.Title
                        @if (!string.IsNullOrWhiteSpace(game.StatusLabel))
                        {
                            <span class="tag @game.StatusClass">@game.StatusLabel</span>
                        }
                    </h2>
                    <p>@game.Description</p>
                    <span class="btn solid">@game.ButtonLabel</span>
                </div>
            </a>
        }
    </section>
</main>

<script src="/js/bg.js"></script>

@code {
    private IJSObjectReference? _module;
    private static readonly IReadOnlyList<GameCard> Games = new[]
    {
        new GameCard(
            Title: "Schach",
            Href: "/chess/",
            Description: "Analysiere Partien, spiele online oder fordere den Stockfish-Bot heraus.",
            ThumbClass: "chess"),
        new GameCard(
            Title: "Snake",
            Href: "/snake",
            Description: "Steuere die Schlange durch die Arena – komplett in C# umgesetzt.",
            ThumbClass: "snake"),
        new GameCard(
            Title: "Tetris",
            Href: "/tetris/",
            Description: "Lass die Steine fallen, räume Reihen ab und knacke deinen Highscore.",
            ThumbClass: "tetris")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/arcadeHome.js");
            await _module.InvokeVoidAsync("setBodyClass", true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setBodyClass", false);
            await _module.DisposeAsync();
        }
    }

    private static string GetCardClasses(GameCard game)
        => game.Highlight ? "card glow" : "card";

    private sealed record GameCard(
        string Title,
        string Href,
        string Description,
        string ThumbClass,
        string ButtonLabel = "Öffnen",
        string StatusLabel = "VERFÜGBAR",
        string StatusClass = "ok",
        bool Highlight = true);
}
